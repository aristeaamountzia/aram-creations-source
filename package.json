{
  "name": "aram-creations",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=server-dist/server.cjs && node scripts/build-netlify-functions.mjs",
    "build:functions": "node scripts/build-netlify-functions.mjs",
    "start": "node server-dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test:stage1": "node scripts/stage1.mjs",
    "test:unit": "node --import ./tests/stage1/network-guard.mjs --import tsx --test server/catalog-excel.test.ts server/media-path.test.ts server/orders-core.test.ts server/request-check.test.ts server/video-policy.test.ts server/vinted-api.test.ts server/vinted-refresh.test.ts tests/portfolio-features.test.ts",
    "lint:stage1": "tsc --noEmit --project tsconfig.stage1.json"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "dotenv": "^17.2.3",
    "exceljs": "4.4.0",
    "express": "^4.21.2",
    "firebase": "^12.19.0",
    "firebase-admin": "^13.5.0",
    "lucide-react": "^0.546.0",
    "mediabunny": "^1.61.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "serverless-http": "^4.0.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.0",
    "@playwright/test": "1.58.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.1",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "firebase-tools": "13.35.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.4.3"
  }
}
