{
  "name": "aram-creations",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild api-server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=server-dist/api-server.cjs && esbuild server.ts --bundle --platform=node --format=esm --packages=external --sourcemap --outfile=server-dist/server.mjs && node scripts/build-netlify-functions.mjs",
    "build:functions": "node scripts/build-netlify-functions.mjs",
    "start": "node server-dist/server.mjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server-dist .netlify",
    "lint": "tsc --noEmit",
    "test": "node scripts/run-tests.mjs",
    "prebuild": "npm run check && node scripts/prepare-media-codecs.mjs",
    "predev": "node scripts/prepare-media-codecs.mjs",
    "check": "npm run lint && npm test",
    "test:integration": "tsx server/orders-integration.test.ts",
    "backup:restore": "tsx scripts/restore-catalog-backup.ts"
  },
  "dependencies": {
    "@ffmpeg/core": "0.12.10",
    "@ffmpeg/ffmpeg": "0.12.15",
    "@google/genai": "^2.4.0",
    "@netlify/aws-lambda-compat": "2.0.4",
    "dotenv": "^17.2.3",
    "exceljs": "4.4.0",
    "express": "^4.21.2",
    "firebase": "^12.19.0",
    "firebase-admin": "^13.5.0",
    "libheif-js": "1.23.5",
    "lucide-react": "^0.546.0",
    "mediabunny": "^1.61.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "serverless-http": "^4.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.1",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "playwright-core": "^1.64.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.4.3"
  }
}
