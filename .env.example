# =============================================================================
# ARAM CREATIONS — ENVIRONMENT CONFIGURATION TEMPLATE
# =============================================================================
# Copy this file to .env for local development. Never commit real keys or credentials.
# On Netlify, configure these variables in Site settings > Environment variables.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. SERVER-SIDE CREDENTIALS (Netlify Functions & Local API Server)
# -----------------------------------------------------------------------------
# Complete Firebase Service Account JSON string for the 'aramcreations-e1529' project.
# Required for: /api/orders, /api/catalog-backups, and admin authentication verification.
FIREBASE_SERVICE_ACCOUNT=

# Primary administrator email address for Back Office authorization.
# Defaults to aristeaamnta@gmail.com if not specified.
ADMIN_EMAIL=aristeaamnta@gmail.com

# Resend API Key for sending automated order confirmation emails to the store owner.
# If omitted or invalid, order processing will succeed and email notification will stay queued.
RESEND_API_KEY=

# Verified owner sender address for order emails (must match domain in Resend).
ORDER_NOTIFICATION_FROM=onboarding@resend.dev

# -----------------------------------------------------------------------------
# 2. BACK OFFICE AI (Gemini + OpenAI Multi-Provider Configuration)
# -----------------------------------------------------------------------------
# Google Gemini API Key (or use GOOGLE_API_KEY).
GEMINI_API_KEY=
GOOGLE_API_KEY=

# Preferred Gemini model (default: gemini-2.5-flash).
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MODEL_ORDER=gemini-2.5-flash,gemini-1.5-flash

# Optional OpenAI API Key for automatic fallback if Gemini quota is exceeded.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_MODEL_ORDER=gpt-4o-mini,gpt-4o

# AI Provider mode: 'auto' (tries Gemini then OpenAI), 'gemini', or 'openai'.
AI_PROVIDER=auto
AI_PROVIDER_ORDER=gemini,openai

# Optional legacy secret code for AI endpoint access.
AI_BACKOFFICE_SECRET=

# -----------------------------------------------------------------------------
# 3. DOMAIN & CORS CONFIGURATION
# -----------------------------------------------------------------------------
# Primary production domain or custom deployment URL.
# Netlify provides URL and DEPLOY_PRIME_URL automatically.
URL=https://aramcreationss.netlify.app

# -----------------------------------------------------------------------------
# 4. OPTIONAL CLIENT-SIDE OVERRIDES (Vite Prefix)
# -----------------------------------------------------------------------------
# If not specified, client-side defaults for project 'aramcreations-e1529' are used.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=aramcreations-e1529.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=aramcreations-e1529
VITE_FIREBASE_STORAGE_BUCKET=aramcreations-e1529.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=989899248568
VITE_FIREBASE_APP_ID=1:989899248568:web:9adbb692b7b1a9e363b54d
