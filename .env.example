# Copy this file to .env and set the keys locally. Never commit real keys.
GEMINI_API_KEY=
# Alternatively, use GOOGLE_API_KEY for Gemini.
GOOGLE_API_KEY=
# Optional custom Gemini-compatible endpoint.
GOOGLE_GEMINI_BASE_URL=
# Optional OpenAI fallback. Leave blank for Gemini only.
OPENAI_API_KEY=
# auto tries configured providers in order; gemini/openai selects one provider.
AI_PROVIDER=auto
AI_PROVIDER_ORDER=gemini,openai
# Optional model overrides and comma-separated fallback lists.
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MODEL_ORDER=
OPENAI_MODEL=gpt-4o-mini
OPENAI_MODEL_ORDER=
# Optional legacy shared-secret access. Firebase admin login is sufficient.
AI_BACKOFFICE_SECRET=
