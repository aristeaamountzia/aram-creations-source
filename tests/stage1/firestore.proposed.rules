// PROPOSAL: emulator only. Never deploy with firebase.json.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && (request.auth.token.get('admin', false) == true || (request.auth.token.get('email', '') == 'aristeaamnta@gmail.com' && request.auth.token.get('email_verified', false) == true));
    }
    match /publicCatalog/{id} {
      allow read: if resource.data.showInShop == true;
      allow write: if isAdmin();
    }
    match /publicSettings/{id} { allow read: if true; allow write: if isAdmin(); }
    match /{document=**} { allow read, write: if isAdmin(); }
  }
}
